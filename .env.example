# WorkCheck Kachchh runtime configuration (copy to .env for production deployment)
# Environment mode: local | production
WC_ENV=local

# Enforce Secure cookie flag & HSTS behind HTTPS TLS termination (1 = enabled)
WC_HTTPS=0

# Comma-separated allowed Host headers (recommended in production, e.g. workcheck.example.com)
WC_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated trusted reverse proxy IPs allowed to supply X-Forwarded-For
WC_TRUSTED_PROXIES=127.0.0.1,::1

# Seed demo accounts (1 in local mode, 0 in production)
WC_DEMO=1

# Session duration in hours
WC_SESSION_HOURS=8

# Override runtime SQLite DB location (defaults to workcheck_platform/data/runtime.db)
WC_RUNTIME_DB=

# Required non-default API key for ESP32 / Wokwi /api/v1/* hardware ingestion in production
WC_DEVICE_KEY=replace-with-32-byte-random-secret

# Optional HTTPS webhook forwarding target (validated against SSRF)
WC_FORWARD_URL=

# Wokwi Bridge settings (wokwi_bridge/app.py)
BRIDGE_ENV=local
BRIDGE_API_KEY=replace-with-32-byte-bridge-secret
BRIDGE_DATA_DB=
BRIDGE_DB=
DASHBOARD_TELEMETRY_URL=
DASHBOARD_API_KEY=
